# Copie para .env e preencha. Nunca faça commit do .env.

# memory = dados em memória (testar sem Azure) | cosmos = Azure Cosmos DB
DB_DRIVER=memory

# Portal Azure → sua conta Cosmos → Keys (Chaves): URI e PRIMARY KEY
COSMOS_ENDPOINT=https://SUA-CONTA.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE=hidratamais

PORT=8080

# Vazio = só a mesma origem (front e API na mesma imagem, o normal).
# Para front em outro domínio: https://meu-front.com (vírgulas para vários) ou *.
CORS_ORIGIN=
